{
  "expo": {
    "name": "Nayl",
    "slug": "nayl-app",
    "scheme": "nayl",
    "owner": "crupid3s-team",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Nayl-cooler-logo.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/25b76779-54fb-4670-83ac-e2f6ada8261d",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nayl.mobile",
      "buildNumber": "23",
      "infoPlist": {
        "NSCameraUsageDescription": "Nayl uses your camera so you can take photos to track your nail progress over time.",
        "NSPhotoLibraryUsageDescription": "Nayl accesses your photo library so you can choose photos to track your nail progress and set a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Nayl saves nail progress photos to your photo library.",
        "NSMicrophoneUsageDescription": "Nayl uses your microphone for guided meditation and relaxation audio features.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Nayl-cooler-logo.png",
        "backgroundColor": "#090A0F"
      },
      "backgroundColor": "#090A0F",
      "icon": "./assets/Nayl-cooler-logo.png",
      "package": "app.nayl.mobile",
      "versionCode": 11,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-updates",
      "expo-video",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.848177887984-jm04rg1n1is8q290qqinpqtdo7kkvfs9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nayl accesses your photo library so you can choose photos to track your nail progress and set a profile picture.",
          "cameraPermission": "Nayl uses your camera so you can take photos to track your nail progress over time."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "extraPods": [
              {
                "name": "GoogleUtilities/Environment",
                "modular_headers": true
              },
              {
                "name": "GoogleUtilities/UserDefaults",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "25b76779-54fb-4670-83ac-e2f6ada8261d"
      }
    }
  }
}
