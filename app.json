{
  "expo": {
    "name": "Nayl",
    "slug": "nayl-app",
    "scheme": "nayl",
    "owner": "lucashoopers-team",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Nayl-cooler-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "updates": {
      "url": "https://u.expo.dev/e3758d2e-40d2-4637-aa97-5f4d3310a4f2",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.nayl.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "NSCameraUsageDescription": "Nayl uses your camera so you can take photos to track your nail progress over time.",
        "NSPhotoLibraryUsageDescription": "Nayl accesses your photo library so you can choose photos to track your nail progress and set a profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Nayl saves nail progress photos to your photo library.",
        "NSMicrophoneUsageDescription": "Nayl uses your microphone for guided meditation and relaxation audio features.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/Nayl-cooler-logo.png",
        "backgroundColor": "#090A0F"
      },
      "backgroundColor": "#090A0F",
      "icon": "./assets/Nayl-cooler-logo.png",
      "package": "app.nayl.mobile",
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#000000",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      "expo-updates",
      "expo-video",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.848177887984-jm04rg1n1is8q290qqinpqtdo7kkvfs9"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nayl accesses your photo library so you can choose photos to track your nail progress and set a profile picture.",
          "cameraPermission": "Nayl uses your camera so you can take photos to track your nail progress over time."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              { "name": "GoogleUtilities/Environment", "modular_headers": true },
              { "name": "GoogleUtilities/UserDefaults", "modular_headers": true },
              { "name": "RecaptchaInterop", "modular_headers": true }
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e3758d2e-40d2-4637-aa97-5f4d3310a4f2"
      }
    }
  }
}
