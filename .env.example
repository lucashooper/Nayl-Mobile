# Copy this file to `.env` and fill in your credentials.
# Find Supabase keys in Supabase Dashboard → Settings → API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat public API keys (RevenueCat Dashboard → Project → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_hFKPjEZtNegsBvTnztfOXTGJuOL
# Optional until Google Play + RevenueCat Android app exist (leave unset for investor sideload APKs)
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_your-android-public-api-key

# Google Sign-In (Google Cloud Console → OAuth 2.0 Client IDs)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=848177887984-jm04rg1n1is8q290qqinpqtdo7kkvfs9.apps.googleusercontent.com
# Web client ID — REQUIRED on iOS for Google Sign-In id tokens (Google Cloud → OAuth Web application client)
# Must also match the client ID configured in Supabase → Authentication → Google provider.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
