{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      }
    },
    "preview-apk": {
      "distribution": "internal",
      "environment": "production",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "channel": "production",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "lucashooper100@outlook.com",
        "ascAppId": "6792496781",
        "appleTeamId": "HMLV274G9F"
      }
    }
  }
}
