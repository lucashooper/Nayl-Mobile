# Fastlane configuration for Nayl iOS (Expo bare workflow)
# Run from ios/:  bundle exec fastlane beta

ENV["LANG"] = "en_US.UTF-8"
ENV["LANGUAGE"] = "en_US.UTF-8"
ENV["LC_ALL"] = "en_US.UTF-8"

FASTLANE_DIR = __dir__
IOS_DIR = File.expand_path("..", FASTLANE_DIR)

# Load ios/fastlane/.env if present (gitignored)
env_file = File.expand_path(".env", FASTLANE_DIR)
if File.exist?(env_file)
  File.foreach(env_file) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    key, value = line.split("=", 2)
    next if key.nil? || value.nil?

    ENV[key] ||= value.strip.delete_prefix('"').delete_suffix('"')
  end
end

def asc_api_key
  key_id = ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_filepath = ENV["APP_STORE_CONNECT_KEY_FILEPATH"] || File.join(FASTLANE_DIR, "AuthKey_254678Q6DV.p8")
  key_filepath = File.expand_path(key_filepath, FASTLANE_DIR) unless Pathname.new(key_filepath).absolute?

  UI.user_error!("Set APP_STORE_CONNECT_KEY_ID in ios/fastlane/.env") if key_id.to_s.empty?
  UI.user_error!("Set APP_STORE_CONNECT_ISSUER_ID in ios/fastlane/.env") if issuer_id.to_s.empty?
  UI.user_error!("API key not found at #{key_filepath}") unless File.exist?(key_filepath)

  app_store_connect_api_key(
    key_id: key_id,
    issuer_id: issuer_id,
    key_filepath: key_filepath
  )
end

default_platform(:ios)

platform :ios do
  desc "Build and submit iOS app to TestFlight / App Store"
  lane :beta do
    api_key = asc_api_key

    sh("node", File.join(IOS_DIR, "..", "scripts", "sync-ios-updates-config.js"))
    increment_build_number(xcodeproj: File.join(IOS_DIR, "Nayl.xcodeproj"))

    build_app(
      workspace: File.join(IOS_DIR, "Nayl.xcworkspace"),
      scheme: "Nayl",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic"
      },
      xcargs: "-allowProvisioningUpdates SWIFT_STRICT_CONCURRENCY=minimal",
      export_xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build iOS IPA locally without uploading"
  lane :build do
    sh("node", File.join(IOS_DIR, "..", "scripts", "sync-ios-updates-config.js"))
    increment_build_number(xcodeproj: File.join(IOS_DIR, "Nayl.xcodeproj"))

    build_app(
      workspace: File.join(IOS_DIR, "Nayl.xcworkspace"),
      scheme: "Nayl",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic"
      },
      xcargs: "-allowProvisioningUpdates SWIFT_STRICT_CONCURRENCY=minimal",
      export_xcargs: "-allowProvisioningUpdates"
    )
  end

  desc "Upload an existing IPA to TestFlight (skip rebuild)"
  lane :upload do
    api_key = asc_api_key

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
